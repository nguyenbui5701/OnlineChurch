{
  "name": "onlinechurch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck && tsc --noEmit --exactOptionalPropertyTypes false",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev:demo": "tsx apps/server/src/index.ts",
    "demo:smoke": "node scripts/demo-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
